<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="hero">
    <h1 class="hero-title"><%= config.home.heroTitle %></h1>
    <p class="hero-subtitle"><%= config.home.heroSubtitle %></p>
    <p class="hero-text"><%= config.home.heroText %></p>
    <div class="hero-actions">
      <% if (user) { %>
        <a class="btn btn-primary" href="/dashboard">Zu meinen Tickets</a>
        <a class="btn btn-ghost" href="/tickets/new">Neues Ticket</a>
      <% } else { %>
        <a class="btn btn-primary" href="/login">Jetzt einloggen (Discord)</a>
        <p class="hint">Nach dem Login siehst du hier alle internen Bereiche und Links – wenn du auf Discord deine Rolle bereits erhalten hast. Sonst siehst du nur deine Tickets.</p>
      <% } %>
    </div>
  </div>

  <% if (images.length > 0) { %>
    <div class="carousel" id="homeCarousel">
      <% images.forEach((src, i) => { %>
        <div class="carousel-slide <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>">
          <img src="<%= src %>" alt="Bild <%= i + 1 %>">
        </div>
      <% }) %>
      <div class="carousel-dots">
        <% images.forEach((_, i) => { %>
          <span class="carousel-dot <%= i === 0 ? 'active' : '' %>" data-dot="<%= i %>"></span>
        <% }) %>
      </div>
    </div>
    <script>window.HOME_SLIDE_SECONDS = <%= slideSeconds %>;</script>
  <% } %>

  <div class="sections">
    <% config.home.sections.forEach((s) => { %>
      <div class="card section-card">
        <h2><%= s.title %></h2>
        <p class="section-text"><%- s.text.replace(/\n/g, '<br>') %></p>
      </div>
    <% }) %>
  </div>

  <% if (user) { %>
    <h2 class="section-heading">Interne Bereiche</h2>
    <div class="tool-grid">
      <a class="tool-card card" href="/dashboard">
        <div class="tool-emoji">🎫</div>
        <h3>Meine Tickets</h3>
        <p class="muted">Deine Anfragen ansehen, verfolgen und neue erstellen.</p>
      </a>
      <a class="tool-card card" href="/tickets/new">
        <div class="tool-emoji">➕</div>
        <h3>Neues Ticket</h3>
        <p class="muted">Ein neues Support-Ticket erstellen.</p>
      </a>
      <a class="tool-card card" href="/account/settings">
        <div class="tool-emoji">⚙️</div>
        <h3>Einstellungen</h3>
        <p class="muted">Benachrichtigungen und Kontodaten.</p>
      </a>
      <% if (isHR) { %>
        <a class="tool-card card" href="/admin">
          <div class="tool-emoji">🗂️</div>
          <h3>Alle Tickets</h3>
          <p class="muted">Alle Tickets im System verwalten.</p>
        </a>
      <% } %>
      <% if (isRoot) { %>
        <a class="tool-card card" href="/admin/accounts">
          <div class="tool-emoji">👥</div>
          <h3>Nutzerverwaltung</h3>
          <p class="muted">Rollen, Sperren und Account-Verläufe.</p>
        </a>
        <a class="tool-card card" href="/admin/logs">
          <div class="tool-emoji">📜</div>
          <h3>Audit-Log</h3>
          <p class="muted">Alle Konto- und Ticket-Aktionen.</p>
        </a>
      <% } %>
      <% if (canStaffLinks && config.staffLinks && config.staffLinks.length) { %>
        <% config.staffLinks.forEach((l) => { %>
          <a class="tool-card card" href="<%= l.url %>" target="_blank" rel="noopener noreferrer">
            <div class="tool-emoji">🔗</div>
            <h3><%= l.label %></h3>
            <p class="muted">Externes Tool öffnen.</p>
          </a>
        <% }) %>
      <% } %>
    </div>
  <% } %>

<%- include('partials/footer') %>
