<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="login-page">
    <div class="login-card">
      <img class="login-logo" src="/static/logo.png" alt="<%= brand %> Logo">
      <h1>TicketSystem MRB</h1>
      <p class="muted">Melde dich mit deinem Discord-Konto an, um deine Tickets zu verwalten.</p>

      <% if (typeof lockedMsg !== 'undefined' && lockedMsg) { %>
        <div class="alert alert-error it-alarm-locked">
          <strong>IT-Alarm – Zugriff gesperrt:</strong> <%= lockedMsg %>
        </div>
        <script>
          // Solange der IT-Alarm aktiv ist, ertönt die Sirene in einer Endlosschleife.
          // Sobald der Alarm beendet ist, stoppt der Ton und die Seite lädt neu.
          (function () {
            var sirenState = null;
            var wasLocked = true;
            function startSiren() {
              if (sirenState) return;
              try {
                var ctx = new (window.AudioContext || window.webkitAudioContext)();
                var osc = ctx.createOscillator();
                var gain = ctx.createGain();
                osc.type = 'sawtooth';
                gain.gain.value = 0.25;
                osc.connect(gain);
                gain.connect(ctx.destination);
                var t = ctx.currentTime + 0.05;
                var i = 0;
                function loop() {
                  if (!sirenState) return;
                  osc.frequency.setValueAtTime(i % 2 === 0 ? 620 : 880, t);
                  t += 0.3;
                  i++;
                  setTimeout(loop, 280);
                }
                osc.start();
                loop();
                sirenState = { ctx: ctx, osc: osc, gain: gain };
              } catch (e) {}
            }
            function stopSiren() {
              if (!sirenState) return;
              try {
                var s = sirenState;
                sirenState = null;
                s.osc.stop();
                s.ctx.close();
              } catch (e) {}
            }
            startSiren();
            setInterval(function () {
              fetch('/api/status', { cache: 'no-store' })
                .then(function (r) { return r.json(); })
                .then(function (st) {
                  var locked = !!(st && st.lockdown && st.lockdown.enabled);
                  if (locked) {
                    startSiren();
                    wasLocked = true;
                  } else if (wasLocked) {
                    wasLocked = false;
                    stopSiren();
                    window.location.reload();
                  }
                })
                .catch(function () {});
            }, 3000);
          })();
        </script>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <button type="button" class="btn btn-discord btn-lg discord-login" data-redirect="/dashboard">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        Mit Discord einloggen
      </button>
      <p class="hint">Du musst Mitglied unseres Discord-Servers sein, sonst wird der Login abgelehnt.
      Die Anmeldung bleibt bis zu 14 Tage aktiv.</p>
    </div>
  </div>

<%- include('partials/footer') %>
