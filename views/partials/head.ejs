<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= brand %></title>
  <link rel="stylesheet" href="/static/css/style.css?v=<%= assetVersion %>">
  <link rel="icon" href="/static/logo.png">
</head>
<body data-user-id="<%= user ? user.id : '' %>" data-notify-enabled="<%= user && user.notify_changes === 1 ? '1' : '0' %>" data-push-key="<%= pushEnabled ? pushPublicKey : '' %>">
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="/">
        <img class="brand-logo" src="/static/logo.png" alt="<%= brand %> Logo">
        <span>TicketSystem <strong>MRB</strong></span>
      </a>
      <% if (user) { %>
        <nav class="nav">
          <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
          <a class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard">Meine Tickets</a>
          <a class="nav-link <%= currentPath.startsWith('/tickets/new') ? 'active' : '' %>" href="/tickets/new">Neues Ticket</a>
          <a class="nav-link <%= currentPath.startsWith('/account/settings') ? 'active' : '' %>" href="/account/settings">Einstellungen</a>
          <% if (isHR) { %>
            <a class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>" href="/admin">Alle Tickets</a>
          <% } %>
          <% if (canStaffLinks) { %>
            <div class="nav-dropdown">
              <button type="button" class="nav-link nav-dropdown-toggle" aria-haspopup="true">Interne Links</button>
              <div class="nav-dropdown-menu">
                <% for (const link of config.staffLinks) { %>
                  <a class="nav-dropdown-item" href="<%= link.url %>" target="_blank" rel="noopener noreferrer">
                    <span class="nav-dropdown-label"><%= link.label %></span>
                    <span class="nav-dropdown-url"><%= link.url %></span>
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>
          <% if (isRoot) { %>
            <a class="nav-link <%= currentPath.startsWith('/admin/accounts') ? 'active' : '' %>" href="/admin/accounts">Nutzerverwaltung</a>
            <a class="nav-link <%= currentPath === '/admin/logs' ? 'active' : '' %>" href="/admin/logs">Audit-Log</a>
          <% } %>
        </nav>
        <div class="user-chip">
          <img class="avatar" src="<%= user.avatar ? 'https://cdn.discordapp.com/avatars/' + user.discord_id + '/' + user.avatar + '.png?size=64' : '/static/img/placeholder.svg' %>" alt="" data-fallback="/static/img/placeholder.svg">
          <span class="user-name"><%= user.global_name || user.username %>
            <% if (user.role === 'hrhr') { %><span class="badge badge-hrhr">Inhaber</span><% } else if (user.role === 'hr') { %><span class="badge badge-hr">Team</span><% } %>
          </span>
          <form method="post" action="/auth/logout" class="inline-form">
            <button type="submit" class="btn btn-ghost btn-sm">Logout</button>
          </form>
        </div>
      <% } else { %>
        <nav class="nav">
          <a class="nav-link" href="/login">Login</a>
        </nav>
      <% } %>
    </div>
  </header>
  <main class="container">
    <% if (flash) { %>
      <div class="alert <%= flash.type === 'error' ? 'alert-error' : 'alert-success' %>"><%= flash.text %></div>
    <% } %>
    <% if (itAlarm) { %>
      <div class="alarm-banner meldung" data-alarm="1"
           data-deadline="<%= alarmDeadline || 0 %>"
           data-root="<%= user && isRoot(user) ? '1' : '0' %>">
        <strong>⚠ Meldung:</strong> <%= itAlarm.text %>
        <% if (!alarmFired) { %>
          <span class="alarm-countdown" data-countdown="1"></span>
          <em class="alarm-sub">Alle Bearbeiter werden gleich automatisch abgemeldet.</em>
        <% } else { %>
          <em class="alarm-sub">Zugriff gesperrt – nur der Inhaber kann sich anmelden, bis die Meldung aufgehoben wird.</em>
        <% } %>
      </div>
      <script>
        (function () {
          var banner = document.querySelector('[data-alarm="1"]');
          if (!banner) return;
          var root = banner.getAttribute('data-root') === '1';
          var deadline = parseInt(banner.getAttribute('data-deadline'), 10) || 0;
          var fired = '<%= alarmFired ? "1" : "" %>' === '1';
          // Alarmton (Web-Audio-Sirene) während der Frist
          if (!fired) {
            try {
              var ctx = new (window.AudioContext || window.webkitAudioContext)();
              var osc = ctx.createOscillator();
              var gain = ctx.createGain();
              osc.type = 'sawtooth';
              gain.gain.setValueAtTime(0.12, ctx.currentTime);
              osc.connect(gain);
              gain.connect(ctx.destination);
              var t0 = ctx.currentTime;
              for (var i = 0; i < 6; i++) {
                osc.frequency.setValueAtTime(620, t0 + i * 0.3);
                osc.frequency.setValueAtTime(880, t0 + i * 0.3 + 0.15);
              }
              osc.start(t0);
              osc.stop(t0 + 1.9);
            } catch (e) {}
          }
          var counter = banner.querySelector('[data-countdown]');
          if (counter && deadline) {
            var tick = function () {
              var left = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
              counter.textContent = 'Automatische Abmeldung in ' + left + ' s';
              if (left > 0) setTimeout(tick, 200);
            };
            tick();
          }
          // Automatische Abmeldung nach Ablauf der Frist (nur eingeloggte, keine Inhaber)
          var uid = document.body.getAttribute('data-user-id');
          if (!root && uid && deadline) {
            var delay = Math.max(0, deadline - Date.now());
            setTimeout(function () {
              var f = document.createElement('form');
              f.method = 'post';
              f.action = '/auth/logout';
              f.style.display = 'none';
              document.body.appendChild(f);
              f.submit();
            }, delay);
          }
        })();
      </script>
    <% } %>
    <% if (lockdown && user && isRoot(user)) { %>
      <div class="alarm-banner lockdown">
        <strong>Zugriff gesperrt:</strong> <%= lockdown.message || 'Der Zugriff wurde für alle Bearbeiter gesperrt.' %>
        <em class="alarm-sub">(Nur du kannst dich derzeit einloggen – deaktivieren unter Einstellungen → Admin-Optionen)</em>
      </div>
    <% } %>
