<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="page-head">
    <div>
      <h1>Audit-Log</h1>
      <p class="muted">Vollständiges Protokoll aller Konto- und Ticket-Aktionen. Nur für festgelegte Inhaber.</p>
    </div>
    <div class="btn-group">
      <a class="btn btn-ghost" href="/admin/accounts">Nutzerverwaltung</a>
      <a class="btn btn-ghost" href="/admin">Alle Tickets</a>
    </div>
  </div>

  <div class="card">
    <form method="get" action="/admin/logs" class="filter-form">
      <div class="form-group">
        <label for="filter">Bereich</label>
        <select name="filter" id="filter">
          <option value="all" <%= filter === 'all' ? 'selected' : '' %>>Alle</option>
          <option value="account" <%= filter === 'account' ? 'selected' : '' %>>Nur Konto-Aktionen</option>
          <option value="ticket" <%= filter === 'ticket' ? 'selected' : '' %>>Nur Ticket-Aktionen</option>
        </select>
      </div>
      <div class="form-group">
        <label for="action">Aktion</label>
        <select name="action" id="action">
          <option value="all" <%= action === 'all' ? 'selected' : '' %>>Alle Aktionen</option>
          <% actions.forEach((a) => { %>
            <option value="<%= a %>" <%= action === a ? 'selected' : '' %>><%= a %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="days">Zeitraum</label>
        <select name="days" id="days">
          <option value="0" <%= String(days) === '0' ? 'selected' : '' %>>Gesamt</option>
          <option value="1" <%= String(days) === '1' ? 'selected' : '' %>>Letzte 24 Std.</option>
          <option value="7" <%= String(days) === '7' ? 'selected' : '' %>>Letzte 7 Tage</option>
          <option value="30" <%= String(days) === '30' ? 'selected' : '' %>>Letzte 30 Tage</option>
        </select>
      </div>
      <div class="form-group grow">
        <label for="user">Nutzer</label>
        <input type="text" name="user" id="user" placeholder="Name / Discord-Username" value="<%= userQuery %>">
      </div>
      <div class="form-group filter-actions">
        <button type="submit" class="btn btn-primary">Filtern</button>
        <a class="btn btn-ghost" href="/admin/logs">Zurücksetzen</a>
      </div>
    </form>
  </div>

  <div class="card">
    <h2>Ticket-Aktionen</h2>
    <% if (ticketLogs.length === 0) { %>
      <p class="muted">Noch keine Ticket-Aktionen protokolliert.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr><th>Zeit</th><th>Ticket</th><th>Aktion</th><th>Durch</th><th>Details</th></tr>
        </thead>
        <tbody>
          <% ticketLogs.forEach((l) => { %>
            <tr>
              <td class="muted small"><%= fmtDate(l.created_at) %></td>
              <td>
                <% if (l.ticket_number) { %>
                  <a class="mono" href="/tickets/<%= l.ticket_id %>">#<%= String(l.ticket_number).padStart(4, '0') %></a>
                <% } else { %>–<% } %>
              </td>
              <td><span class="tag log-<%= l.action %>"><%= l.action %></span></td>
              <td><%= l.actor_global || l.actor_name || '–' %></td>
              <td class="small"><%= l.details || '–' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h2>Konto-Aktionen</h2>
    <% if (accountLogs.length === 0) { %>
      <p class="muted">Noch keine Konto-Aktionen protokolliert.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr><th>Zeit</th><th>Aktion</th><th>Konto</th><th>Durch</th><th>Details</th></tr>
        </thead>
        <tbody>
          <% accountLogs.forEach((l) => { %>
            <tr>
              <td class="muted small"><%= fmtDate(l.created_at) %></td>
              <td><span class="tag log-<%= l.action %>"><%= l.action %></span></td>
              <td><%= l.account_name || '–' %></td>
              <td><%= l.actor_global || l.actor_name || '–' %></td>
              <td class="small"><%= l.reason || '–' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

<%- include('partials/footer') %>
