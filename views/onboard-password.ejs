<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="login-page">
    <div class="login-card">
      <div class="login-logo">🗝️</div>
      <h1>Passwort festlegen</h1>
      <p class="muted">Fast geschafft! Lege jetzt dein persönliches Passwort fest.</p>

      <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
        <div class="alert alert-error">
          <ul style="margin:0;padding-left:18px;">
            <% errors.forEach((e) => { %><li><%= e %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form method="post" action="/onboard/password" class="login-form">
        <div class="form-group">
          <label for="password">Neues Passwort *</label>
          <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
          <p class="hint">Mindestens 8 Zeichen.</p>
        </div>
        <div class="form-group">
          <label for="password_confirm">Passwort wiederholen *</label>
          <input type="password" id="password_confirm" name="password_confirm" required minlength="8" autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">Passwort speichern</button>
      </form>
    </div>
  </div>

<%- include('partials/footer') %>
