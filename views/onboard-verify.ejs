<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="login-page">
    <div class="login-card">
      <div class="login-logo">📧</div>
      <h1>E-Mail verifizieren</h1>
      <p class="muted">Wir haben einen <strong>6-stelligen Code</strong> an
      <strong><%= user.pending_email %></strong> gesendet.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="post" action="/onboard/verify" class="login-form">
        <div class="form-group">
          <label for="code">Verifizierungscode</label>
          <input type="text" id="code" name="code" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" style="text-align:center;font-size:1.4rem;letter-spacing:6px;">
        </div>
        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">Code bestätigen</button>
      </form>
    </div>
  </div>

<%- include('partials/footer') %>
