<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="login-page">
    <div class="login-card">
      <img class="login-logo" src="/static/logo.png" alt="<%= brand %> Logo">
      <h1>Passwort vergessen</h1>

      <% if (sent) { %>
        <div class="alert alert-success">
          Falls ein Konto mit dieser Angabe existiert, haben wir dir eine E-Mail mit einem Link zum Zurücksetzen geschickt.
        </div>
        <a class="btn btn-primary btn-lg btn-block" href="/login">Zurück zum Login</a>
      <% } else { %>
        <p class="muted">Gib deine E-Mail-Adresse oder deinen Benutzernamen ein. Du erhältst danach einen Link zum Zurücksetzen.</p>

        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form method="post" action="/forgot-password" class="login-form">
          <div class="form-group">
            <label for="identifier">E-Mail oder Benutzername</label>
            <input type="text" id="identifier" name="identifier" required autocomplete="username">
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-block">Link senden</button>
        </form>
      <% } %>

      <p class="muted small" style="margin-top:16px;">
        <a href="/login">← Zurück zum Login</a>
      </p>
    </div>
  </div>

<%- include('partials/footer') %>
