<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="page-head">
    <div>
      <h1>Kontoeinstellungen</h1>
      <p class="muted">Dein Konto ist mit deinem Discord-Account verbunden. Die E-Mail-Adresse wird aus Discord übernommen und kann hier nicht geändert werden.</p>
    </div>
  </div>

  <div class="card">
    <h2>Benachrichtigungen</h2>
    <p class="muted">
      Lass dich benachrichtigen, wenn sich an deinen Tickets etwas ändert (z. B. neue Nachrichten oder Statusänderungen).
      <% if (pushEnabled) { %>
        Die Hinweise erscheinen als Browser-Benachrichtigung – auch dann, wenn diese Website geschlossen ist
        (der Browser muss lediglich geöffnet sein bzw. im Hintergrund laufen).
      <% } else { %>
        Die Hinweise erscheinen als Browser-Benachrichtigung, solange diese Website im Browser geöffnet ist.
        Push-Benachrichtigungen (auch bei geschlossener Website) sind auf diesem Server noch nicht eingerichtet.
      <% } %>
    </p>

    <form method="post" action="/account/settings" class="notify-form">
      <label class="checkbox-row">
        <input type="checkbox" name="notify_changes" value="1" <%= user.notify_changes === 1 ? 'checked' : '' %>>
        <span>
          <strong>Bei Ticketänderungen benachrichtigen</strong>
          <span class="hint">Nutzer: Änderungen an deinen eigenen Tickets. Team/Inhaber: Änderungen an allen Tickets.</span>
        </span>
      </label>
      <button type="submit" class="btn btn-primary">Einstellungen speichern</button>
    </form>

    <p class="hint" style="margin-top:16px;">
      Browser-Benachrichtigungen müssen zusätzlich vom Browser erlaubt werden:
      <button type="button" class="btn btn-sm btn-secondary" id="enable-notifications">Benachrichtigungen im Browser aktivieren</button>
      <span id="notify-permission" class="hint"></span>
    </p>
  </div>

  <div class="card">
    <h2>Account</h2>
    <table class="table">
      <tbody>
        <tr>
          <td class="small">Discord-Name</td>
          <td><strong><%= user.global_name || user.username %></strong> (@<%= user.discord_username %>)</td>
        </tr>
        <tr>
          <td class="small">E-Mail</td>
          <td><%= user.email || 'Keine E-Mail-Adresse hinterlegt (in Discord hinterlegen)' %></td>
        </tr>
        <tr>
          <td class="small">Rolle</td>
          <td><%= roleLabels[user.role] || user.role %></td>
        </tr>
        <tr>
          <td class="small">Registriert</td>
          <td><%= fmtDate(user.created_at) %></td>
        </tr>
        <tr>
          <td class="small">Letzter Login</td>
          <td><%= fmtDate(user.last_login) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <% if (adminData) { %>
    <div class="card admin-options">
      <h2>Admin-Optionen</h2>
      <p class="muted">Nur für festgelegte Inhaber sichtbar.</p>

      <h3>IT-Alarm</h3>
      <% if (adminData.lockdown) { %>
        <p class="hint">
          IT-Alarm ist <strong>aktiv</strong>: „<%= adminData.lockdown.message || adminData.lockdownDefaultMsg %>" – der
          Zugriff ist <strong>gesperrt</strong>, nur dein Account kann sich einloggen.
        </p>
        <form method="post" action="/account/settings/admin/lockdown" class="inline-form">
          <input type="hidden" name="action" value="disable">
          <button type="submit" class="btn btn-ghost" data-confirm="IT-Alarm beenden und Zugriff für alle Bearbeiter wieder freigeben?">IT-Alarm beenden &amp; Zugriff freigeben</button>
        </form>
      <% } else { %>
        <p class="hint">Löst einen IT-Alarm aus: Alle eingeloggten Bearbeiter sehen sofort eine rote Vollbild-Meldung „IT-Alarm: &lt;Text&gt;" mit Alarmton und werden ausgeloggt. Sie können sich erst wieder anmelden, wenn du den IT-Alarm beendest.</p>
        <form method="post" action="/account/settings/admin/lockdown" class="admin-form">
          <input type="hidden" name="action" value="enable">
          <label class="small">Text für die rote Meldung</label>
          <input type="text" name="message" class="input" value="<%= adminData.lockdownDefaultMsg %>" placeholder="Der Zugriff auf das System wurde gerade für alle Bearbeiter gesperrt.">
          <button type="submit" class="btn btn-danger" data-confirm="Wirklich den IT-Alarm auslösen? Alle eingeloggten Bearbeiter werden abgemeldet.">IT-Alarm auslösen &amp; Zugriff sperren</button>
        </form>
      <% } %>

      <hr class="admin-sep">

      <h3>Meldungen</h3>
      <p class="hint">Zeigt oben auf den ausgewählten Websites einen gelben Hinweis-Banner – ohne Ton, ohne Sperre. Mehrere Meldungen können gleichzeitig aktiv sein.</p>
      <% if (adminData.alarms && adminData.alarms.length) { %>
        <ul class="admin-messages">
          <% for (const m of adminData.alarms) { %>
            <li class="admin-message">
              <div>
                <div class="admin-message-text">„<%= m.text %>"</div>
                <div class="admin-message-meta">
                  <% if (m.websites && m.websites.length) { %>
                    <%= m.websites.map((w) => adminData.sites[w] || w).join(', ') %>
                  <% } else { %>
                    alle Websites
                  <% } %>
                  <% if (m.set_at) { %> · <%= fmtDate(m.set_at) %><% } %>
                </div>
              </div>
              <form method="post" action="/account/settings/admin/alarm" class="inline-form">
                <input type="hidden" name="action" value="remove">
                <input type="hidden" name="id" value="<%= m.id %>">
                <button type="submit" class="btn btn-ghost btn-sm" data-confirm="Diese Meldung entfernen?">Entfernen</button>
              </form>
            </li>
          <% } %>
        </ul>
      <% } else { %>
        <p class="hint">Aktuell ist keine Meldung aktiv.</p>
      <% } %>
      <form method="post" action="/account/settings/admin/alarm" class="admin-form">
        <input type="hidden" name="action" value="set">
        <label class="small">Meldungstext *</label>
        <input type="text" name="text" class="input" required placeholder="z. B. Achtung: Wartungsarbeiten am Freitag 18–20 Uhr">
        <label class="small">Anzeigen auf (ohne Auswahl = alle Websites)</label>
        <div class="checkbox-row">
          <% for (const key of Object.keys(adminData.sites)) { %>
            <label class="checkbox-label">
              <input type="checkbox" name="websites" value="<%= key %>">
              <%= adminData.sites[key] %>
            </label>
          <% } %>
        </div>
        <button type="submit" class="btn btn-primary">Meldung anzeigen</button>
      </form>

      <hr class="admin-sep">

      <h3>Voice-Support (Hotline)</h3>
      <p class="hint">Einstellungen für die Support-Hotline. Aktuelle Nummer: <strong><%= adminData.support.hotline || '–' %></strong> – sie wird automatisch aus den Daten abgeleitet und nach Vorwahl-Wechsel neu erzeugt.</p>
      <form method="post" action="/account/settings/admin/support" class="admin-form">
        <div class="form-row">
          <div class="form-group">
            <label class="small">Vorwahl der Hotline-Nummer</label>
            <input type="text" name="hotlinePrefix" class="input" value="<%= adminData.support.hotlinePrefix %>" placeholder="z. B. 0800">
          </div>
          <div class="form-group">
            <label class="small">Klingelzeit bis zurück in die Warteschlange (Sekunden)</label>
            <input type="number" name="ringTimeoutMs" class="input" min="5" max="120" value="<%= Math.round(adminData.support.ringTimeoutMs / 1000) %>">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="small">Aktualisierung der Seiten (Sekunden)</label>
            <input type="number" name="pollMs" class="input" min="1" max="60" value="<%= Math.round(adminData.support.pollMs / 1000) %>">
          </div>
          <div class="form-group">
            <label class="small">STUN-Server (kommagetrennt)</label>
            <input type="text" name="stunServers" class="input" value="<%= adminData.support.stunServers.join(', ') %>">
          </div>
        </div>
        <label class="small">Hinweistext, wenn kein Mitarbeiter verfügbar ist</label>
        <input type="text" name="noStaffMessage" class="input" value="<%= adminData.support.noStaffMessage %>">
        <label class="small">Text unter dem „Support anrufen“-Button (Wartezeit-Hinweis)</label>
        <input type="text" name="queueEstimateLabel" class="input" value="<%= adminData.support.queueEstimateLabel %>">
        <div class="form-row">
          <div class="form-group">
            <label class="small">Geschätzte Minuten pro Anruf (Wartezeit-Anzeige)</label>
            <input type="number" name="minutesPerCall" class="input" min="1" max="30" value="<%= adminData.support.minutesPerCall %>">
          </div>
          <div class="form-group">
            <label class="small">WhatsApp-Alarm ab dieser Warteschlangen-Größe</label>
            <input type="number" name="queueAlertThreshold" class="input" min="1" max="50" value="<%= adminData.support.queueAlertThreshold %>">
          </div>
        </div>
        <%
          const hourSchedule = adminData.support.supportHours && adminData.support.supportHours.schedule
            ? adminData.support.supportHours.schedule
            : {};
          const hourEnabled = adminData.support.supportHours ? adminData.support.supportHours.enabled : false;
          const dayNames = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'];
          const hourDays = [];
          for (let d = 1; d <= 7; d++) {
            const slot = hourSchedule[String(d)];
            if (slot && slot.start && slot.end) hourDays.push(d);
          }
        %>
        <div class="form-group" style="margin-top:4px;">
          <label class="small">Support-Zeiten festlegen (deaktiviert = immer erreichbar)</label>
          <label class="check-line" style="margin:6px 0 8px;">
            <input type="checkbox" name="supportHoursEnabled" value="1" <%= hourEnabled ? 'checked' : '' %>>
            Nur zu festen Zeiten erreichbar
          </label>
          <table class="table table-compact support-hours-table">
            <thead>
              <tr><th></th><th>Tag</th><th>Von (HH:MM, Europe/Berlin)</th><th>Bis (HH:MM)</th></tr>
            </thead>
            <tbody>
              <% dayNames.forEach((dn, i) => {
                const d = i + 1;
                const slot = hourSchedule[String(d)] || {};
                const active = hourDays.includes(d);
              %>
                <tr>
                  <td class="small" style="width:32px;">
                    <input type="checkbox" name="supportHoursDays" value="<%= d %>" <%= active ? 'checked' : '' %>>
                  </td>
                  <td class="small"><%= dn %></td>
                  <td class="small" style="min-width:130px;">
                    <input type="time" name="supportHoursStart_<%= d %>" class="input" value="<%= slot.start || '09:00' %>">
                  </td>
                  <td class="small" style="min-width:130px;">
                    <input type="time" name="supportHoursEnd_<%= d %>" class="input" value="<%= slot.end || '18:00' %>">
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="hint small">Nur angehakte Tage mit gültiger Uhrzeit gelten als erreichbar. Außerhalb der Zeiten können keine Anrufe gestartet werden.</p>
        </div>
        <button type="submit" class="btn btn-primary">Voice-Support-Einstellungen speichern</button>
      </form>

      <h3 style="margin-top:22px;">Warteschleifenmusik</h3>
      <p class="hint">
        Lade hier Songs hoch – sie werden dauerhaft gespeichert und in der Warteschleife abgespielt.
        Bei mehreren Songs wird pro Anruf zufällig einer ausgewählt. Ohne eigene Songs wird die Standard-Warteschleifenmusik verwendet.
      </p>
      <form method="post" action="/account/settings/admin/support/hold-music" enctype="multipart/form-data" class="admin-form">
        <div class="form-row">
          <div class="form-group">
            <label class="small">Audiodatei (MP3, WAV, OGG, M4A, WEBM, AAC, FLAC; max. 20 MB)</label>
            <input type="file" name="song" class="input" accept="audio/*,.mp3,.wav,.ogg,.m4a,.webm,.aac,.flac" required>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Song hochladen</button>
      </form>

      <% if (adminData.support.holdMusic && adminData.support.holdMusic.length) { %>
        <table class="table table-compact" style="margin-top:14px;">
          <thead>
            <tr><th>Song</th><th>Größe</th><th>Hochgeladen</th><th></th></tr>
          </thead>
          <tbody>
            <% adminData.support.holdMusic.forEach((s) => { %>
              <tr>
                <td><strong><%= s.name %></strong></td>
                <td class="small"><%= s.size > 1048576 ? (s.size / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(s.size / 1024)) + ' KB' %></td>
                <td class="muted small"><%= fmtDate(s.added_at) %></td>
                <td class="small" style="white-space:nowrap;">
                  <form method="post" action="/account/settings/admin/support/hold-music/<%= s.id %>/delete" class="inline-form"
                        data-confirm="Diesen Song wirklich löschen?">
                    <button type="submit" class="btn btn-sm btn-danger">Löschen</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="muted" style="margin-top:12px;">Noch keine Songs hochgeladen – die Standard-Warteschleifenmusik wird verwendet.</p>
      <% } %>

      <hr class="admin-sep">

      <h3>Aufzeichnungen</h3>
      <p class="hint">
        Alle Gespräche im Voice-Support werden vom Mitarbeiter automatisch aufgezeichnet.
        Aufzeichnungen werden nach <strong>4 Monaten automatisch gelöscht</strong>.
      </p>
      <% if (adminData.support.recordings && adminData.support.recordings.length) { %>
        <table class="table table-compact" style="margin-top:14px;">
          <thead>
            <tr><th>Anruf</th><th>Datum</th><th>Anrufer</th><th>Mitarbeiter</th><th>Größe</th><th></th></tr>
          </thead>
          <tbody>
            <% adminData.support.recordings.forEach((r) => { %>
              <tr>
                <td><strong><%= '#SUP-' + String(r.call_id).padStart(4, '0') %></strong></td>
                <td class="muted small"><%= fmtDate(r.created_at) %></td>
                <td class="small"><%= r.caller_global || r.caller_username || '–' %></td>
                <td class="small"><%= r.staff_global || r.staff_username || '–' %></td>
                <td class="small"><%= r.size > 1048576 ? (r.size / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(r.size / 1024)) + ' KB' %></td>
                <td class="small" style="white-space:nowrap;">
                  <audio controls preload="none" src="/api/support/recordings/<%= r.id %>" style="height:32px;"></audio>
                  <form method="post" action="/account/settings/admin/support/recordings/<%= r.id %>/delete" class="inline-form"
                        data-confirm="Diese Aufzeichnung wirklich löschen?">
                    <button type="submit" class="btn btn-sm btn-danger">Löschen</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="muted" style="margin-top:12px;">Noch keine Aufzeichnungen vorhanden.</p>
      <% } %>

      <hr class="admin-sep">

      <h3>Mitarbeiter-Abfrage</h3>
      <p class="hint">
        Schichtzeiten und Aktivitäten eines Mitarbeiters anhand seiner Nummer (Durchwahl) abrufen –
        wann er eingestempelt war, seine Anrufe, Tickets und der Konto-Verlauf.
      </p>
      <form method="get" action="/account/settings/admin/employee" class="form-row">
        <div class="form-group grow">
          <input type="number" name="number" class="input" min="1" step="1"
                 placeholder="Durchwahl des Mitarbeiters, z. B. 2" required>
        </div>
        <div class="form-group">
          <button type="submit" class="btn btn-primary">Mitarbeiter abrufen</button>
        </div>
      </form>

      <hr class="admin-sep">

      <h3>System-Neustart</h3>
      <p class="hint">Startet den Server komplett neu (ca. 1–2 Minuten Ausfallzeit). Tickets und Daten bleiben erhalten.</p>
      <form method="post" action="/account/settings/admin/restart" class="inline-form">
        <button type="submit" class="btn btn-ghost" data-confirm="System wirklich neu starten?">System neu starten</button>
      </form>

      <hr class="admin-sep">

      <h3>Backups</h3>
      <p class="hint">
        <strong><%= adminData.backupSlotsFree %> / <%= adminData.backupMax %> Slots frei.</strong>
        Automatisch wöchentlich; bei 20/20 wird kein Backup mehr erstellt, bis aufgeräumt wird (monatlich automatisch bzw. jederzeit manuell durch jlg09).
      </p>
      <form method="post" action="/account/settings/admin/backups/create" class="inline-form">
        <button type="submit" class="btn btn-primary" <%= adminData.backupSlotsFree === 0 ? 'disabled' : '' %>>
          <%= adminData.backupSlotsFree === 0 ? 'Kein Platz (0/20) – erst aufräumen' : 'Manuelles Backup erstellen' %>
        </button>
      </form>

      <% if (adminData.backups.length) { %>
        <table class="table table-compact" style="margin-top:14px;">
          <thead>
            <tr><th>Zeit</th><th>Art</th><th>Größe</th><th></th></tr>
          </thead>
          <tbody>
            <% adminData.backups.forEach((b) => { %>
              <tr>
                <td class="muted small"><%= fmtDate(b.created_at) %></td>
                <td><span class="tag <%= b.kind === 'manual' ? 'log-invited' : 'log-enabled' %>"><%= b.kind === 'manual' ? 'Manuell' : 'Auto' %></span></td>
                <td class="small"><%= b.size > 1048576 ? (b.size / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b.size / 1024)) + ' KB' %></td>
                <td class="small" style="white-space:nowrap;">
                  <a class="btn btn-sm btn-ghost" href="/account/settings/admin/backups/<%= b.id %>/download">Download</a>
                  <form method="post" action="/account/settings/admin/backups/<%= b.id %>/restore" class="inline-form"
                        data-force-confirm="Dieses Backup wirklich wiederherstellen? ALLE aktuellen Daten (Tickets, Nutzer, Nachrichten, Anrufe, Einstellungen, ...) werden durch den Stand dieses Backups ersetzt. Dies kann nicht rückgängig gemacht werden.">
                    <input type="hidden" name="force" value="0">
                    <button type="submit" class="btn btn-sm btn-danger">Wiederherstellen</button>
                  </form>
                  <form method="post" action="/account/settings/admin/backups/<%= b.id %>/delete" class="inline-form"
                        data-confirm="Dieses Backup wirklich löschen?">
                    <button type="submit" class="btn btn-sm btn-ghost">Löschen</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <form method="post" action="/account/settings/admin/backups/clear" class="inline-form" style="margin-top:10px;"
              data-confirm="Wirklich ALLE Backups löschen? Das gibt alle 20 Slots frei und kann nicht rückgängig gemacht werden.">
          <button type="submit" class="btn btn-sm btn-danger">Alle Backups löschen (jlg09)</button>
        </form>
      <% } else { %>
        <p class="muted" style="margin-top:12px;">Noch keine Backups vorhanden. Das erste automatische Backup wird in der ersten Woche erstellt – oder du erstellst jetzt eins.</p>
      <% } %>
    </div>
  <% } %>

<%- include('partials/footer') %>
