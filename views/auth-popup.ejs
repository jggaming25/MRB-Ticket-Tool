<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Weiterleitung...</title>
  <link rel="stylesheet" href="/static/css/style.css">
  <link rel="icon" href="/static/logo.png">
</head>
<body class="popup-body">
  <div class="popup-card">
    <img class="popup-logo" src="/static/logo.png" alt="Logo">
    <div class="popup-spinner" aria-hidden="true"></div>
    <p class="popup-title">Anmeldung erfolgreich</p>
    <p class="popup-sub">Du wirst weitergeleitet...</p>
  </div>
  <script>
    try {
      if (window.opener && window.opener !== window) {
        window.opener.location.href = '<%= redirectTo %>';
        window.close();
      } else {
        window.location.href = '<%= redirectTo %>';
      }
    } catch (e) {
      window.location.href = '<%= redirectTo %>';
    }
  </script>
</body>
</html>
