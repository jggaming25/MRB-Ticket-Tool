<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="page-head">
    <div>
      <h1>Team-Verwaltung</h1>
      <p class="muted">Hier vergibst du Rollen für alle Konten, die sich bereits angemeldet haben. Nur Inhaber können Team-Accounts ändern oder löschen.</p>
    </div>
    <div class="btn-group">
      <a class="btn btn-ghost" href="/admin/logs">Audit-Log</a>
      <a class="btn btn-ghost" href="/admin">← Alle Tickets</a>
    </div>
  </div>

  <div class="stat-grid">
    <div class="stat-card">
      <span class="stat-value"><%= stats.total %></span>
      <span class="stat-label">Konten gesamt</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.hr %></span>
      <span class="stat-label">Team aktiv</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.disabled %></span>
      <span class="stat-label">Deaktiviert</span>
    </div>
  </div>

  <div class="card">
    <form method="get" action="/admin/accounts" class="filter-form">
      <div class="form-group">
        <label for="filter">Status</label>
        <select name="filter" id="filter">
          <option value="all" <%= filter === 'all' ? 'selected' : '' %>>Alle</option>
          <option value="user" <%= filter === 'user' ? 'selected' : '' %>>Nutzer</option>
          <option value="hr" <%= filter === 'hr' ? 'selected' : '' %>>Nur Team</option>
          <option value="disabled" <%= filter === 'disabled' ? 'selected' : '' %>>Deaktiviert</option>
          <option value="deleted" <%= filter === 'deleted' ? 'selected' : '' %>>Gelöscht</option>
        </select>
      </div>
      <div class="form-group grow">
        <label for="search">Suche</label>
        <input type="text" name="search" id="search" placeholder="Name, E-Mail oder Discord-Username ..." value="<%= search %>">
      </div>
      <div class="form-group filter-actions">
        <button type="submit" class="btn btn-primary">Filtern</button>
        <a class="btn btn-ghost" href="/admin/accounts">Zurücksetzen</a>
      </div>
    </form>
  </div>

  <div class="card">
    <% if (users.length === 0) { %>
      <p class="muted">Keine Accounts gefunden. Sobald sich jemand mit Discord anmeldet, taucht er hier auf.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Account</th>
            <th>E-Mail / Discord</th>
            <th>Rolle</th>
            <th>Status</th>
            <th>Tickets</th>
            <th>Registriert</th>
            <th>Letzter Login</th>
            <th>Aktionen</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((u) => { %>
            <tr class="<%= u.id === myId ? 'row-me' : '' %>">
              <td>
                <div class="user-cell">
                  <img class="avatar" src="<%= u.avatar ? 'https://cdn.discordapp.com/avatars/' + u.discord_id + '/' + u.avatar + '.png?size=64' : '/static/img/placeholder.svg' %>" onerror="this.src='/static/img/placeholder.svg'">
                  <div>
                    <strong><%= u.global_name || u.username %></strong>
                    <% if (u.id === myId) { %><span class="badge">Du</span><% } %>
                    <div class="muted small">@<%= u.discord_username || '–' %></div>
                  </div>
                </div>
              </td>
              <td class="small"><%= u.email || '–' %></td>
              <td><span class="tag <%= u.role === 'hrhr' ? 'role-hrhr' : (u.role === 'hr' ? 'role-hr' : 'role-user') %>"><%= roleLabels[u.role] || u.role %></span></td>
              <td><span class="tag acc-<%= u.status %>"><%= accountStatusLabel(u.status) %></span></td>
              <td><%= u.ticket_count %></td>
              <td class="muted small"><%= fmtDate(u.created_at) %></td>
              <td class="muted small"><%= fmtDate(u.last_login) %></td>
              <td>
                <% if (u.id !== myId && u.status !== 'deleted') { %>
                  <details class="acc-actions">
                    <summary class="btn btn-sm btn-ghost">Aktionen ▾</summary>
                    <div class="acc-actions-body">
                      <form method="post" action="/admin/accounts/<%= u.id %>/role">
                        <label class="small">Rolle festlegen</label>
                        <select name="role" class="input">
                          <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>Nutzer</option>
                          <option value="hr" <%= u.role === 'hr' ? 'selected' : '' %>>Team</option>
                          <option value="hrhr" <%= u.role === 'hrhr' ? 'selected' : '' %>>Inhaber</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Rolle setzen</button>
                        <p class="hint">Inhaber nur möglich, wenn der Nutzer in <code>.env</code> als AUTHORIZED_DISCORD_USERNAMES festgelegt ist.</p>
                      </form>
                      <% if (u.status === 'disabled') { %>
                        <form method="post" action="/admin/accounts/<%= u.id %>/enable">
                          <label class="small">Grund (optional)</label>
                          <input type="text" name="reason" placeholder="Grund der Reaktivierung">
                          <button type="submit" class="btn btn-sm btn-primary">Reaktivieren</button>
                        </form>
                      <% } else if (u.role !== 'hrhr') { %>
                        <form method="post" action="/admin/accounts/<%= u.id %>/disable">
                          <label class="small">Begründung *</label>
                          <input type="text" name="reason" required placeholder="Warum deaktivieren?">
                          <button type="submit" class="btn btn-sm btn-danger">Deaktivieren</button>
                        </form>
                      <% } %>
                      <% if (u.role !== 'hrhr') { %>
                        <form method="post" action="/admin/accounts/<%= u.id %>/delete"
                              onsubmit="return confirm('Konto wirklich löschen? Diese Aktion wird dem Nutzer per E-Mail mitgeteilt.');">
                          <label class="small">Begründung *</label>
                          <input type="text" name="reason" required placeholder="Warum löschen?">
                          <button type="submit" class="btn btn-sm btn-danger">Löschen</button>
                        </form>
                      <% } %>
                    </div>
                  </details>
                <% } else if (u.id === myId) { %>
                  <span class="muted small">Du</span>
                <% } else { %>
                  <span class="muted small">Gelöscht</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h2>Verlauf (Audit-Log)</h2>
    <% if (logs.length === 0) { %>
      <p class="muted">Noch keine Aktionen protokolliert.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr><th>Zeit</th><th>Aktion</th><th>Konto</th><th>Durch</th><th>Begründung</th></tr>
        </thead>
        <tbody>
          <% logs.forEach((l) => { %>
            <tr>
              <td class="muted small"><%= fmtDate(l.created_at) %></td>
              <td><span class="tag log-<%= l.action %>"><%= l.action %></span></td>
              <td><%= l.account_name || '–' %></td>
              <td><%= l.actor_name || '–' %></td>
              <td class="small"><%= l.reason || '–' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

<%- include('partials/footer') %>
