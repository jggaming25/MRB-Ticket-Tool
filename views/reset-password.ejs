<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="login-page">
    <div class="login-card">
      <img class="login-logo" src="/static/logo.png" alt="<%= brand %> Logo">
      <h1>Passwort zurücksetzen</h1>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="post" action="/reset-password" class="login-form">
        <input type="hidden" name="token" value="<%= token %>">
        <div class="form-group">
          <label for="password">Neues Passwort</label>
          <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label for="password_confirm">Passwort wiederholen</label>
          <input type="password" id="password_confirm" name="password_confirm" required autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Passwort speichern</button>
      </form>
    </div>
  </div>

<%- include('partials/footer') %>
