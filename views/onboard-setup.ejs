<%- include('partials/head', { title, user, isHR, isHRHR, currentPath }) %>

  <div class="login-page">
    <div class="login-card">
      <div class="login-logo">🔐</div>
      <h1>Konto einrichten</h1>
      <p class="muted">Dein Discord-Konto <strong><%= user.global_name || user.username %></strong> wurde erkannt.
      Lege jetzt dein Passwort fest.</p>

      <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
        <div class="alert alert-error">
          <ul style="margin:0;padding-left:18px;">
            <% errors.forEach((e) => { %><li><%= e %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form method="post" action="/onboard/setup" class="login-form">
        <div class="form-group">
          <label for="email">E-Mail-Adresse (aus deinem Discord-Konto)</label>
          <input type="email" id="email" value="<%= discordEmail %>" disabled>
          <p class="hint">Diese E-Mail kommt aus deinem Discord-Konto und kann nicht geändert werden.</p>
        </div>
        <div class="form-group">
          <label for="password">Passwort *</label>
          <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label for="password_confirm">Passwort wiederholen *</label>
          <input type="password" id="password_confirm" name="password_confirm" required minlength="8" autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">Konto fertig einrichten</button>
      </form>

      <form method="post" action="/auth/logout" class="inline-form" style="margin-top:14px;">
        <button type="submit" class="btn btn-ghost" style="width:100%;">Abbrechen &amp; ausloggen</button>
      </form>
    </div>
  </div>

<%- include('partials/footer') %>
