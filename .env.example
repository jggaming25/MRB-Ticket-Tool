# ===== Discord Developer Portal (https://discord.com/developers/applications) =====
# Neue Application anlegen -> OAuth2 -> Redirect URL hinzufuegen:
#   http://localhost:3000/auth/callback
# DISCORD_CLIENT_ID und DISCORD_CLIENT_SECRET kopieren.

DISCORD_CLIENT_ID=deine_client_id
DISCORD_CLIENT_SECRET=dein_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# ===== Discord-Server (Mitgliedspruefung) =====
# Server-ID (Guild-ID) deines Discord-Servers. Beim Login wird geprueft, ob der
# Nutzer Mitglied dieses Servers ist. Ist das Feld leer, wird die Pruefung
# uebersprungen. So findest du die ID:
#   Discord -> Server-Einstellungen -> Widget -> "Server-ID" (oder Entwicklermodus).
DISCORD_GUILD_ID=

# Optional: Einladungslink, der auf der Fehlerseite angezeigt wird, wenn jemand
# nicht auf dem Server ist (z. B. https://discord.gg/deinlink).
DISCORD_INVITE_URL=

# ===== Server =====
PORT=3000
BASE_URL=http://localhost:3000

# ===== Turso (Cloud-Datenbank) =====
# NUR fuer den Produktiv-Deploy (z. B. Render) noetig – lokal kann das leer bleiben.
# So bekommst du die Werte:
#   1. Konto auf https://turso.tech anlegen (kostenlos, keine Kreditkarte)
#   2. "Create database" (z. B. "ticketsystem") und Region waehlen
#   3. Bei der Datenbank "Generate token" -> Token kopieren
#   4. Hier eintragen:
# TURSO_URL=libsql://ticketsystem-<dein-org>.turso.io
# TURSO_AUTH_TOKEN=<dein_token>
TURSO_URL=
TURSO_AUTH_TOKEN=

# Geheimer Schluessel fuer die Session. Zufaellig erzeugen, z.B. mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=bitte_aendern_zu_einem_langen_zufaelligen_string

# ===== HR-HR (Owner) =====
# Kommagetrennte Discord-Usernames, die sich das erste Mal ueber Discord
# anmelden und dann als HR-HR-Account eingerichtet werden
# (Email angeben + verifizieren + Passwort festlegen). Beispiel:
#   AUTHORIZED_DISCORD_USERNAMES=jlg09
# Es wird gegen username, Anzeigename (global_name) und username#1234 geprueft.
# Diese Nutzer sind die EINZIGEN mit Zugriff auf HR-Verwaltung, Audit-Log und
# Rechtevergabe (Root-HR-HR).
AUTHORIZED_DISCORD_USERNAMES=jlg09

# ===== E-Mail-Versand (SMTP) =====
# Ohne SMTP-Konfiguration werden Mails nur in den Ordner mail-log/ geschrieben
# und in der Konsole geloggt (praktisch zum Testen).
# Free-SMTP-Optionen fuer mehr als nur Tests: Brevo (brevo.com) Free-Tier.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TicketSystem MRB <noreply@localhost>"

# ===== Web-Push-Benachrichtigungen (Browser/Desktop, auch wenn die Website
# geschlossen ist – der Browser muss nur laufen) =====
# Schluessel einmalig erzeugen mit:
#   npx web-push generate-vapid-keys
# Dann PUBLIC als VAPID_PUBLIC_KEY und PRIVATE als VAPID_PRIVATE_KEY eintragen.
VAPID_SUBJECT=mailto:deine@email.de
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
